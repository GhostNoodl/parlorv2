{
  "name": "parlor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @parlor/server --filter @parlor/web dev",
    "build": "pnpm --filter @parlor/web build",
    "start": "pnpm build && pnpm --filter @parlor/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @parlor/server db:generate"
  }
}
